# Database
DATABASE_URL=sqlite+aiosqlite:///./spendy.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
# For PostgreSQL use:
# POSTGRES_PASSWORD=CHANGE_ME_STRONG # Postgres password (used by docker compose)
# DATABASE_URL=postgresql+asyncpg://user:CHANGE_ME_STRONG@localhost/spendy

# Security
REGISTRATION_ENABLED=false
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
# Web sessions use this value as an inactivity timeout and renew while the user is active.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Workspace invitations (request-driven SMTP delivery)
PUBLIC_BASE_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@localhost
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
WORKSPACE_INVITATION_LIFETIME_DAYS=7

# Application
APP_NAME=Spendy
DEBUG=True
